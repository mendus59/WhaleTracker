rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own preferences.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is closed until server-side ingestion lands (phase 2).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

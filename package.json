{
  "name": "whaletracker",
  "version": "1.0.0",
  "description": "Puget Sound whale & orca sighting tracker",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "android:sync": "npm run build && cap sync android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mendus59/whaletracker.git"
  },
  "bugs": {
    "url": "https://github.com/mendus59/whaletracker/issues"
  },
  "homepage": "https://github.com/mendus59/whaletracker#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "firebase": "^11.10.0",
    "leaflet": "1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^13.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
